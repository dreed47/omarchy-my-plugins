#!/usr/bin/python3
"""Hardened I/O helper for My Plugins.

Invoked as `/usr/bin/python3 -I scripts/my-plugins sync ...`. Does not
consult PATH, HOME, or XDG. Paths arrive as absolute argv. Cache lives
under an ownership-checked, no-follow directory and is opened
descriptor-relative. Network is https to two allowlisted hosts, no
redirects, with a hard byte cap and timeout.
"""
from __future__ import annotations

import argparse
import errno
import json
import os
import re
import ssl
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import Any

MAX_CATALOG_BYTES = 16 * 1024 * 1024
MAX_STATS_BYTES = 1 * 1024 * 1024
MAX_GITHUB_BYTES = 256 * 1024
MAX_INTERNAL_BYTES = 64 * 1024
MAX_MANIFEST_BYTES = 8192
MAX_INSTALLED = 256
MAX_STDOUT_BYTES = 256 * 1024
CATALOG_MAX_AGE_SEC = 21600
STATS_MAX_AGE_SEC = 1800
GITHUB_MAX_AGE_SEC = 1800
FETCH_TIMEOUT_SEC = 25

CATALOG_URL = "https://plugins.omarchy.org/catalog.json"
STATS_URL = "https://api.omarchyplugins.com/v1/stats"
ALLOWED_PATHS = {
    "plugins.omarchy.org": {"/catalog.json": False},
    "api.omarchyplugins.com": {"/v1/stats": False},
    "api.github.com": {"/search/issues": True},
}
PLUGIN_ID_RE = re.compile(r"\b(io\.github\.[A-Za-z0-9._-]{1,80})\b")
REPO_URL_RE = re.compile(r"https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)")
ISSUE_URL_RE = re.compile(
    r"^https://github\.com/omacom/omarchy-plugin-marketplace/issues/([1-9][0-9]{0,8})$"
)
GITHUB_SEARCH_Q_RE = re.compile(
    r"^repo:omacom/omarchy-plugin-marketplace is:issue author:[A-Za-z0-9-]+$"
)

O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
O_NONBLOCK = getattr(os, "O_NONBLOCK", 0)


class Fail(Exception):
    pass


def uid() -> int:
    return os.getuid()


def _mode(st: os.stat_result) -> int:
    return st.st_mode & 0o777


def _has_group_or_other_write(st: os.stat_result) -> bool:
    return bool(st.st_mode & (stat.S_IWGRP | stat.S_IWOTH))


def _is_owned_dir(st: os.stat_result) -> None:
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise Fail("not an owned directory")
    if st.st_uid != uid():
        raise Fail("directory not owned by the user")
    if _has_group_or_other_write(st):
        raise Fail("directory is group- or world-writable")


def _is_owned_file(st: os.stat_result) -> None:
    if not stat.S_ISREG(st.st_mode):
        raise Fail("not a regular file")
    if st.st_uid != uid():
        raise Fail("file not owned by the user")
    if _has_group_or_other_write(st):
        raise Fail("file is group- or world-writable")


def _fchmod_checked(fd: int, mode: int) -> os.stat_result:
    os.fchmod(fd, mode)
    st = os.fstat(fd)
    if _mode(st) != mode:
        raise Fail("could not set private mode")
    return st


def assert_running_helper_private() -> None:
    # The inode Python already mapped. Follow is intentional: this is the
    # executed file, not a path we will later write through.
    fd = os.open(__file__, os.O_RDONLY | O_CLOEXEC)
    try:
        _is_owned_file(os.fstat(fd))
    finally:
        os.close(fd)


def open_home(home: str) -> int:
    if not home or not home.startswith("/") or "\x00" in home:
        raise Fail("home must be an absolute filesystem path")
    if ".." in home.split("/"):
        raise Fail("home must not contain ..")
    fd = os.open(home, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
    try:
        _is_owned_dir(os.fstat(fd))
        return fd
    except Exception:
        os.close(fd)
        raise


def rel_parts_under_home(home: str, abs_path: str) -> list[str]:
    if not abs_path or not abs_path.startswith("/") or "\x00" in abs_path:
        raise Fail("path must be an absolute filesystem path")
    home_n = home.rstrip("/")
    path_n = abs_path.rstrip("/")
    if path_n == home_n:
        return []
    prefix = home_n + "/"
    if not path_n.startswith(prefix):
        raise Fail("path is not under home")
    parts = [p for p in path_n[len(prefix):].split("/") if p]
    if ".." in parts:
        raise Fail("path must not contain ..")
    return parts


def open_owned_dir_under_home(
    home: str, abs_path: str, create: bool, private_leaf: bool = False
) -> int:
    parts = rel_parts_under_home(home, abs_path)
    fd = open_home(home)
    try:
        for i, part in enumerate(parts):
            if part in (".", "..") or "/" in part or "\x00" in part:
                raise Fail("bad path component")
            created = False
            try:
                nxt = os.open(
                    part,
                    os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC,
                    dir_fd=fd,
                )
            except FileNotFoundError:
                if not create:
                    raise Fail("missing directory")
                os.mkdir(part, 0o700, dir_fd=fd)
                created = True
                nxt = os.open(
                    part,
                    os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC,
                    dir_fd=fd,
                )
            except OSError as e:
                raise Fail("refusing to follow a symlink") from e
            os.close(fd)
            fd = nxt
            st = os.fstat(fd)
            if st.st_uid != uid() or not stat.S_ISDIR(st.st_mode):
                raise Fail("not an owned directory")
            is_leaf = i == len(parts) - 1
            # Newly created components and the plugin-owned state leaf are
            # ours to lock down. Shared ancestors (.local, .config, …) are
            # only rejected if group/other-writable; chmod there would
            # surprise other programs.
            if created or (private_leaf and is_leaf):
                st = _fchmod_checked(fd, 0o700)
            _is_owned_dir(st)
        return fd
    except Exception:
        os.close(fd)
        raise


def read_at(dir_fd: int, name: str, cap: int) -> bytes:
    flags = os.O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC
    fd = os.open(name, flags, dir_fd=dir_fd)
    try:
        st = os.fstat(fd)
        _is_owned_file(st)
        if st.st_size > cap:
            raise Fail("file exceeds size bound")
        chunks: list[bytes] = []
        total = 0
        while True:
            try:
                buf = os.read(fd, 65536)
            except BlockingIOError as e:
                raise Fail("not a regular file") from e
            if not buf:
                break
            total += len(buf)
            if total > cap:
                raise Fail("file exceeds size bound")
            chunks.append(buf)
        return b"".join(chunks)
    finally:
        os.close(fd)


def write_at(dir_fd: int, name: str, data: bytes, cap: int) -> None:
    if len(data) > cap:
        raise Fail("write exceeds size bound")
    tmp = f".{name}.{os.getpid()}.{time.time_ns():x}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW | O_CLOEXEC
    fd = os.open(tmp, flags, 0o600, dir_fd=dir_fd)
    try:
        st = _fchmod_checked(fd, 0o600)
        _is_owned_file(st)
        off = 0
        while off < len(data):
            off += os.write(fd, data[off:])
        os.fsync(fd)
    except Exception:
        os.close(fd)
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    os.close(fd)
    try:
        st = os.lstat(name, dir_fd=dir_fd)
    except FileNotFoundError:
        st = None
    if st is not None:
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
            try:
                os.unlink(tmp, dir_fd=dir_fd)
            except OSError:
                pass
            raise Fail("refusing to overwrite a non-regular file")
        if st.st_uid != uid():
            try:
                os.unlink(tmp, dir_fd=dir_fd)
            except OSError:
                pass
            raise Fail("refusing to overwrite a file not owned by the user")
    try:
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)
        out = os.open(name, os.O_RDONLY | O_NOFOLLOW | O_CLOEXEC, dir_fd=dir_fd)
        try:
            st = _fchmod_checked(out, 0o600)
            _is_owned_file(st)
        finally:
            os.close(out)
    except Exception:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def read_json_at(dir_fd: int, name: str, cap: int) -> Any:
    try:
        raw = read_at(dir_fd, name, cap)
    except Fail:
        return None
    except FileNotFoundError:
        return None
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args: Any, **kwargs: Any) -> None:
        return None


def assert_github_search_query(query: str, fragment: str) -> None:
    if fragment:
        raise Fail("fragment is not allowed")
    qs = urllib.parse.parse_qs(query, keep_blank_values=False)
    if set(qs.keys()) - {"q", "per_page"}:
        raise Fail("query is not allowlisted")
    q = (qs.get("q") or [""])[0]
    if not GITHUB_SEARCH_Q_RE.fullmatch(q):
        raise Fail("query is not allowlisted")
    if "per_page" in qs and qs.get("per_page") != ["30"]:
        raise Fail("query is not allowlisted")


def assert_allowed_url(url: str) -> None:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https":
        raise Fail("only https is allowed")
    if parsed.username or parsed.password:
        raise Fail("url must not contain userinfo")
    host = parsed.hostname or ""
    if host not in ALLOWED_PATHS:
        raise Fail("host is not allowlisted")
    if parsed.port not in (None, 443):
        raise Fail("port is not allowed")
    if re.fullmatch(r"[0-9.]+", host) or ":" in host:
        raise Fail("address literals are not allowed")
    path = parsed.path or ""
    allow_query = ALLOWED_PATHS[host].get(path)
    if allow_query is None:
        raise Fail("path is not allowlisted")
    if allow_query:
        assert_github_search_query(parsed.query, parsed.fragment)
        return
    if parsed.query or parsed.fragment:
        raise Fail("query and fragment are not allowed")


def github_search_url(github_user: str) -> str:
    user = normalize_github_user(github_user)
    if not user:
        return ""
    q = f"repo:omacom/omarchy-plugin-marketplace is:issue author:{user}"
    return "https://api.github.com/search/issues?" + urllib.parse.urlencode(
        {"q": q, "per_page": "30"}
    )


def fetch_url(url: str, etag: str, cap: int, timeout: int) -> dict[str, Any]:
    assert_allowed_url(url)
    headers = {
        "User-Agent": "my-plugins/0.1.8 (Omarchy helper; github.com/dreed47/omarchy-my-plugins)",
        "Accept": "application/vnd.github+json" if "api.github.com" in url else "application/json",
        "Accept-Encoding": "identity",
    }
    if etag:
        headers["If-None-Match"] = etag
    req = urllib.request.Request(url, headers=headers, method="GET")
    ctx = ssl.create_default_context()
    opener = urllib.request.build_opener(
        NoRedirect(),
        urllib.request.HTTPSHandler(context=ctx),
    )
    try:
        resp = opener.open(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        if e.code == 304:
            return {"status": 304, "etag": etag, "body": b""}
        raise Fail(f"http {e.code}") from e
    except urllib.error.URLError as e:
        raise Fail("fetch failed") from e
    try:
        status = getattr(resp, "status", 200)
        got_etag = resp.headers.get("ETag") or resp.headers.get("etag") or ""
        chunks: list[bytes] = []
        total = 0
        while True:
            buf = resp.read(65536)
            if not buf:
                break
            total += len(buf)
            if total > cap:
                raise Fail("response exceeds size bound")
            chunks.append(buf)
        return {"status": int(status), "etag": got_etag, "body": b"".join(chunks)}
    finally:
        resp.close()


def pretty_name(plugin_id: str) -> str:
    last = plugin_id.split(".")[-1] if plugin_id else ""
    return last.replace("-", " ").replace("_", " ").title()


def github_user_from_id(plugin_id: str) -> str:
    m = re.match(r"^io\.github\.([^.]+)\.", plugin_id, re.I)
    return m.group(1) if m else ""


def normalize_github_user(value: str) -> str:
    s = str(value or "").strip().split()[0] if str(value or "").strip() else ""
    s = re.sub(r"^https?://(www\.)?github\.com/", "", s, flags=re.I)
    if s.startswith("@"):
        s = s[1:]
    s = re.split(r"[/?#]", s)[0]
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?", s or ""):
        return ""
    return s


def parse_catalog(raw: Any) -> list[dict[str, Any]]:
    if not isinstance(raw, dict):
        return []
    items = raw.get("plugins")
    if not isinstance(items, list):
        return []
    out: list[dict[str, Any]] = []
    for item in items:
        if not isinstance(item, dict):
            continue
        pid = str(item.get("id") or "")
        if not pid:
            continue
        out.append(
            {
                "id": pid,
                "name": str(item.get("name") or pretty_name(pid)),
                "description": str(item.get("description") or ""),
                "author": str(item.get("author") or ""),
                "version": str(item.get("version") or ""),
                "repo": str(item.get("repo") or ""),
                "listedAt": str(item.get("listedAt") or item.get("addedAt") or ""),
                "kind": str(item.get("kind") or ""),
                "category": str(item.get("category") or ""),
                "stars": int(item.get("stars") or 0),
                "verified": str(item.get("verificationStatus") or "") == "verified",
                "verification": str(
                    item.get("verificationCoverage") or item.get("verificationStatus") or ""
                ),
                "listed": True,
                "local": False,
                "views": 0,
                "copies": 0,
                "hearts": 0,
            }
        )
    return out


def parse_stats(raw: Any) -> dict[str, Any]:
    if not isinstance(raw, dict):
        return {}
    plugins = raw.get("plugins")
    return plugins if isinstance(plugins, dict) else {}


def join_rows(plugins: list[dict[str, Any]], stats: dict[str, Any]) -> list[dict[str, Any]]:
    out = []
    for p in plugins:
        row = dict(p)
        s = stats.get(p["id"]) if isinstance(stats.get(p["id"]), dict) else {}
        row["views"] = int(s.get("views") or 0)
        row["copies"] = int(s.get("copies") or 0)
        row["hearts"] = int(s.get("hearts") or 0)
        out.append(row)
    return out


def matches_owner(plugin: dict[str, Any], owner: dict[str, str]) -> bool:
    user = (owner.get("githubUser") or "").lower()
    author = (owner.get("authorName") or "").lower()
    prefix = (owner.get("idPrefix") or "").lower()
    if not user and not author and not prefix:
        return False
    pid = str(plugin.get("id") or "").lower()
    repo = str(plugin.get("repo") or "").lower()
    plugin_author = str(plugin.get("author") or "").lower()
    if prefix and pid.startswith(prefix):
        return True
    if user:
        if pid.startswith("io.github." + user + "."):
            return True
        if repo.startswith("https://github.com/" + user + "/"):
            return True
    if author and plugin_author == author:
        return True
    return False


def infer_github_user(installed: dict[str, Any], self_id: str) -> str:
    counts: dict[str, int] = {}
    for pid in installed:
        if pid == self_id:
            continue
        user = github_user_from_id(pid)
        if not user:
            continue
        counts[user] = counts.get(user, 0) + 1
    best = ""
    n = 0
    for user, c in counts.items():
        if c > n or (c == n and (best == "" or user < best)):
            best = user
            n = c
    return best if n else ""


def repo_guess(pid: str) -> str:
    user = github_user_from_id(pid)
    slug = pid.split(".")[-1] if pid else ""
    if not user or not slug:
        return ""
    return f"https://github.com/{user}/omarchy-{slug}"


def sanitize_github_repo_url(url: str) -> str:
    s = str(url or "").strip()
    if not s or any(c in s for c in " \t\r\n"):
        return ""
    m = re.fullmatch(r"git@github\.com:([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+?)(?:\.git)?", s)
    if not m:
        m = re.fullmatch(
            r"https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+?)(?:\.git)?/?",
            s,
        )
    if not m:
        return ""
    return f"https://github.com/{m.group(1)}/{m.group(2)}"


def parse_origin_url(config: bytes) -> str:
    try:
        text = config.decode("utf-8")
    except UnicodeDecodeError:
        return ""
    in_origin = False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            in_origin = s.lower() == '[remote "origin"]'
            continue
        if in_origin:
            key, sep, val = s.partition("=")
            if sep and key.strip().lower() == "url":
                return sanitize_github_repo_url(val.strip())
    return ""


def origin_from_checkout(dir_fd: int) -> str:
    try:
        git_fd = os.open(
            ".git",
            os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC,
            dir_fd=dir_fd,
        )
    except OSError:
        return ""
    try:
        raw = read_at(git_fd, "config", 65536)
    except (Fail, FileNotFoundError, OSError):
        return ""
    finally:
        os.close(git_fd)
    return parse_origin_url(raw)


def open_plugin_checkout(home: str, plugins_fd: int, name: str) -> int | None:
    """Open a plugin directory without walking through a planted symlink.

    A real directory is opened O_NOFOLLOW. A single absolute symlink whose
    target sits under HOME is opened by walking that target from HOME with
    the same ownership / no-group-write checks. Relative links, links
    outside HOME, and group/other-writable targets are skipped.
    """
    try:
        fd = os.open(
            name,
            os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC,
            dir_fd=plugins_fd,
        )
        try:
            _is_owned_dir(os.fstat(fd))
        except Fail:
            os.close(fd)
            return None
        return fd
    except OSError as e:
        if e.errno not in (errno.ELOOP, errno.ENOTDIR):
            return None
    try:
        st = os.lstat(name, dir_fd=plugins_fd)
    except OSError:
        return None
    if not stat.S_ISLNK(st.st_mode) or st.st_uid != uid():
        return None
    try:
        target = os.readlink(name, dir_fd=plugins_fd)
    except OSError:
        return None
    if not target.startswith("/") or "\x00" in target or ".." in target.split("/"):
        return None
    try:
        return open_owned_dir_under_home(home, target, create=False, private_leaf=False)
    except Fail:
        return None


def scan_installed(home: str, plugins_dir: str) -> dict[str, Any]:
    out: dict[str, Any] = {}
    try:
        dir_fd = open_owned_dir_under_home(home, plugins_dir, create=False, private_leaf=False)
    except Fail:
        return out
    try:
        entries = os.listdir(dir_fd)
        n = 0
        for name in entries:
            if n >= MAX_INSTALLED:
                break
            if name.startswith("."):
                continue
            child = open_plugin_checkout(home, dir_fd, name)
            if child is None:
                continue
            try:
                raw = read_at(child, "manifest.json", MAX_MANIFEST_BYTES)
                data = json.loads(raw.decode("utf-8"))
                if not isinstance(data, dict) or not data.get("id"):
                    continue
                pid = str(data["id"])
                out[pid] = {
                    "id": pid,
                    "name": str(data.get("name") or pretty_name(pid)),
                    "version": str(data.get("version") or ""),
                    "author": str(data.get("author") or ""),
                    "dir": name,
                    "repo": origin_from_checkout(child),
                }
                n += 1
            except (Fail, FileNotFoundError, UnicodeDecodeError, json.JSONDecodeError, OSError):
                continue
            finally:
                os.close(child)
    finally:
        os.close(dir_fd)
    return out


def merge_local(
    owned: list[dict[str, Any]], installed: dict[str, Any], owner: dict[str, str]
) -> list[dict[str, Any]]:
    seen = {row["id"] for row in owned}
    out = []
    for row in owned:
        rec = installed.get(row["id"])
        if rec:
            c = dict(row)
            c["local"] = True
            if not c.get("version") and rec.get("version"):
                c["version"] = rec["version"]
            out.append(c)
        else:
            out.append(row)
    for pid, rec in installed.items():
        if pid in seen:
            continue
        if not matches_owner(rec, owner):
            continue
        out.append(
            {
                "id": rec["id"],
                "name": rec["name"],
                "description": "",
                "author": rec.get("author") or "",
                "version": rec.get("version") or "",
                "repo": rec.get("repo") or repo_guess(rec["id"]),
                "listedAt": "",
                "kind": "",
                "category": "",
                "stars": 0,
                "verified": False,
                "verification": "unlisted",
                "listed": False,
                "local": True,
                "views": 0,
                "copies": 0,
                "hearts": 0,
            }
        )
    return out


def parse_marketplace_issues(raw: Any) -> list[dict[str, Any]]:
    if not isinstance(raw, dict):
        return []
    items = raw.get("items")
    if not isinstance(items, list):
        return []
    out: list[dict[str, Any]] = []
    for item in items[:30]:
        if not isinstance(item, dict):
            continue
        try:
            number = int(item.get("number") or 0)
        except (TypeError, ValueError):
            continue
        if number <= 0:
            continue
        html = str(item.get("html_url") or "")
        if not ISSUE_URL_RE.fullmatch(html):
            continue
        state = str(item.get("state") or "")
        if state not in ("open", "closed"):
            continue
        labels: list[str] = []
        for lab in item.get("labels") or []:
            name = lab.get("name") if isinstance(lab, dict) else ""
            if name:
                labels.append(str(name)[:64])
            if len(labels) >= 12:
                break
        body = str(item.get("body") or "")
        ids = list(dict.fromkeys(PLUGIN_ID_RE.findall(body)))[:8]
        repos: list[str] = []
        for user, name in REPO_URL_RE.findall(body):
            if name.endswith(".git"):
                name = name[:-4]
            repos.append(f"https://github.com/{user}/{name}")
            if len(repos) >= 8:
                break
        title = str(item.get("title") or "")[:200]
        if "plugin-update" in labels or title.startswith("[Verify]"):
            kind = "verify"
        elif "submission" in labels or title.startswith("[Plugin]"):
            kind = "listing"
        else:
            kind = "other"
        if kind == "other" and not ids:
            continue
        out.append(
            {
                "number": number,
                "url": html,
                "state": state,
                "title": title,
                "labels": labels,
                "pluginIds": ids,
                "repos": repos,
                "kind": kind,
            }
        )
    return out


def issue_status_label(iss: dict[str, Any]) -> str:
    if iss.get("state") != "open":
        return ""
    labels = iss.get("labels") or []
    if "security-needs-fixes" in labels:
        return "blocked"
    if "security-review-required" in labels:
        return "in review"
    if "plugin-update" in labels or iss.get("kind") == "verify":
        return "verify filed"
    if "submission" in labels or iss.get("kind") == "listing":
        return "listing filed"
    return "issue open"


def _issue_rank(iss: dict[str, Any]) -> tuple:
    open_rank = 0 if iss.get("state") == "open" else 1
    kind_rank = {"verify": 0, "listing": 1, "other": 2}.get(str(iss.get("kind") or ""), 9)
    return (open_rank, kind_rank, -int(iss.get("number") or 0))


def attach_issues(rows: list[dict[str, Any]], issues: list[dict[str, Any]]) -> list[dict[str, Any]]:
    best_id: dict[str, dict[str, Any]] = {}
    best_repo: dict[str, dict[str, Any]] = {}
    for iss in issues:
        if iss.get("state") != "open":
            continue
        for pid in iss.get("pluginIds") or []:
            prev = best_id.get(pid)
            if prev is None or _issue_rank(iss) < _issue_rank(prev):
                best_id[pid] = iss
        for repo in iss.get("repos") or []:
            prev = best_repo.get(repo)
            if prev is None or _issue_rank(iss) < _issue_rank(prev):
                best_repo[repo] = iss
    out = []
    for row in rows:
        c = dict(row)
        iss = best_id.get(str(c.get("id") or "")) or best_repo.get(str(c.get("repo") or ""))
        if not iss:
            c["issueNumber"] = 0
            c["issueUrl"] = ""
            c["issueState"] = ""
            c["issueKind"] = ""
            c["issueStatus"] = ""
        else:
            c["issueNumber"] = int(iss["number"])
            c["issueUrl"] = str(iss["url"])
            c["issueState"] = str(iss["state"])
            c["issueKind"] = str(iss["kind"])
            c["issueStatus"] = issue_status_label(iss)
        out.append(c)
    return out


def totals(rows: list[dict[str, Any]]) -> dict[str, int]:
    t = {
        "plugins": 0,
        "listed": 0,
        "unlisted": 0,
        "views": 0,
        "copies": 0,
        "hearts": 0,
        "stars": 0,
    }
    for r in rows:
        t["plugins"] += 1
        if r.get("listed"):
            t["listed"] += 1
            t["views"] += int(r.get("views") or 0)
            t["copies"] += int(r.get("copies") or 0)
            t["hearts"] += int(r.get("hearts") or 0)
            t["stars"] += int(r.get("stars") or 0)
        else:
            t["unlisted"] += 1
    return t


def sort_key_name(key: str) -> str:
    k = (key or "views").lower()
    if k in ("copies", "installs", "hearts", "stars", "newest", "name"):
        return "copies" if k == "installs" else k
    return "views"


def sort_rows(rows: list[dict[str, Any]], key: str) -> list[dict[str, Any]]:
    k = sort_key_name(key)
    copy = list(rows)

    def keyfn(a: dict[str, Any]) -> tuple:
        name = str(a.get("name") or "").lower()
        if k == "name":
            return (name,)
        if k == "newest":
            ts = 0.0
            try:
                ts = time.mktime(time.strptime(str(a.get("listedAt") or "")[:19], "%Y-%m-%dT%H:%M:%S"))
            except (ValueError, OverflowError):
                ts = 0.0
            return (-ts, name)
        listed = 0 if a.get("listed") else 1
        return (listed, -int(a.get(k) or 0), name)

    copy.sort(key=keyfn)
    return copy


def emit(payload: dict[str, Any]) -> None:
    raw = json.dumps(payload, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
    if len(raw) > MAX_STDOUT_BYTES:
        raw = json.dumps(
            {"ok": False, "error": "output exceeds size bound", "rows": [], "totals": totals([])},
            separators=(",", ":"),
        ).encode("utf-8")
    sys.stdout.buffer.write(raw)
    sys.stdout.buffer.write(b"\n")


def cmd_sync(args: argparse.Namespace) -> int:
    assert_running_helper_private()
    state_fd = open_owned_dir_under_home(args.home, args.state_dir, create=True, private_leaf=True)
    try:
        internal = read_json_at(state_fd, "internal.json", MAX_INTERNAL_BYTES) or {}
        if not isinstance(internal, dict):
            internal = {}
        catalog_etag = str(internal.get("catalogEtag") or "")
        catalog_at = float(internal.get("catalogFetchedAt") or 0)
        stats_at = float(internal.get("statsFetchedAt") or 0)
        github_at = float(internal.get("githubFetchedAt") or 0)
        now_ms = time.time() * 1000
        force = bool(args.force)
        error = ""

        if force or (now_ms - catalog_at) / 1000 >= CATALOG_MAX_AGE_SEC:
            try:
                got = fetch_url(CATALOG_URL, catalog_etag, MAX_CATALOG_BYTES, FETCH_TIMEOUT_SEC)
                if got["status"] == 304:
                    catalog_at = now_ms
                elif got["status"] == 200 and got["body"]:
                    json.loads(got["body"].decode("utf-8"))
                    write_at(state_fd, "catalog.json", got["body"], MAX_CATALOG_BYTES)
                    catalog_etag = str(got["etag"] or "")
                    catalog_at = now_ms
                else:
                    error = "catalog fetch failed"
            except (Fail, UnicodeDecodeError, json.JSONDecodeError) as e:
                error = str(e) if str(e) else "catalog fetch failed"

        if force or (now_ms - stats_at) / 1000 >= STATS_MAX_AGE_SEC:
            try:
                got = fetch_url(STATS_URL, "", MAX_STATS_BYTES, FETCH_TIMEOUT_SEC)
                if got["status"] == 200 and got["body"]:
                    json.loads(got["body"].decode("utf-8"))
                    write_at(state_fd, "stats.json", got["body"], MAX_STATS_BYTES)
                    stats_at = now_ms
                else:
                    if not error:
                        error = "stats fetch failed"
            except (Fail, UnicodeDecodeError, json.JSONDecodeError) as e:
                if not error:
                    error = str(e) if str(e) else "stats fetch failed"

        write_at(
            state_fd,
            "internal.json",
            json.dumps(
                {
                    "catalogEtag": catalog_etag,
                    "catalogFetchedAt": catalog_at,
                    "statsFetchedAt": stats_at,
                    "githubFetchedAt": github_at,
                }
            ).encode("utf-8"),
            MAX_INTERNAL_BYTES,
        )

        catalog = parse_catalog(read_json_at(state_fd, "catalog.json", MAX_CATALOG_BYTES) or {})
        stats = parse_stats(read_json_at(state_fd, "stats.json", MAX_STATS_BYTES) or {})
        joined = join_rows(catalog, stats)
        installed = scan_installed(args.home, args.plugins_dir) if args.plugins_dir else {}
        self_id = "io.github.dreed47.my-plugins"
        configured = normalize_github_user(args.github_user)
        guessed = infer_github_user(installed, self_id)
        owner = {
            "githubUser": configured or guessed,
            "authorName": (args.author_name or "").strip(),
            "idPrefix": (args.id_prefix or "").strip(),
        }
        owned = [row for row in joined if matches_owner(row, owner)]
        if str(args.show_unlisted).lower() in ("on", "true", "1"):
            owned = merge_local(owned, installed, owner)
        owned = sort_rows(owned, args.sort)

        search = github_search_url(owner["githubUser"])
        if search and (force or (now_ms - github_at) / 1000 >= GITHUB_MAX_AGE_SEC):
            try:
                got = fetch_url(search, "", MAX_GITHUB_BYTES, FETCH_TIMEOUT_SEC)
                if got["status"] == 200 and got["body"]:
                    parsed = parse_marketplace_issues(json.loads(got["body"].decode("utf-8")))
                    write_at(
                        state_fd,
                        "github.json",
                        json.dumps(parsed).encode("utf-8"),
                        MAX_GITHUB_BYTES,
                    )
                    github_at = now_ms
                    write_at(
                        state_fd,
                        "internal.json",
                        json.dumps(
                            {
                                "catalogEtag": catalog_etag,
                                "catalogFetchedAt": catalog_at,
                                "statsFetchedAt": stats_at,
                                "githubFetchedAt": github_at,
                            }
                        ).encode("utf-8"),
                        MAX_INTERNAL_BYTES,
                    )
            except (Fail, UnicodeDecodeError, json.JSONDecodeError, OSError):
                # Tracking is optional; a GitHub blip must not hide catalog stats.
                pass
        issues_raw = read_json_at(state_fd, "github.json", MAX_GITHUB_BYTES) or []
        issues = issues_raw if isinstance(issues_raw, list) else parse_marketplace_issues(issues_raw)
        owned = attach_issues(owned, issues)
        payload = {
            "ok": True,
            "error": error,
            "guessedUser": guessed,
            "userIsGuessed": configured == "",
            "owner": owner,
            "rows": owned,
            "totals": totals(owned),
        }
        emit(payload)
        return 0
    finally:
        os.close(state_fd)


def main(argv: list[str] | None = None) -> int:
    os.umask(0o077)
    parser = argparse.ArgumentParser(prog="my-plugins")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sync = sub.add_parser("sync")
    sync.add_argument("--home", required=True)
    sync.add_argument("--state-dir", required=True)
    sync.add_argument("--plugins-dir", default="")
    sync.add_argument("--github-user", default="")
    sync.add_argument("--author-name", default="")
    sync.add_argument("--id-prefix", default="")
    sync.add_argument("--show-unlisted", default="On")
    sync.add_argument("--sort", default="Views")
    sync.add_argument("--force", action="store_true")
    args = parser.parse_args(argv)
    try:
        if args.cmd == "sync":
            return cmd_sync(args)
        raise Fail("unknown command")
    except Fail as e:
        emit({"ok": False, "error": str(e), "rows": [], "totals": totals([]), "guessedUser": "", "owner": {}})
        return 1


if __name__ == "__main__":
    sys.exit(main())
